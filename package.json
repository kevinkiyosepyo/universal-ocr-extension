{
  "name": "universal-ocr-extension",
  "version": "1.0.0",
  "private": true,
  "description": "Local image and page-region text recognition for Chromium browsers",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "demo": "node scripts/demo.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/smoke-browser.mjs",
    "check": "npm test && npm run build",
    "package": "npm run check && node scripts/package.mjs"
  },
  "dependencies": {
    "@tesseract.js-data/chi_sim": "1.0.0",
    "@tesseract.js-data/deu": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/fra": "1.0.0",
    "@tesseract.js-data/jpn": "1.0.0",
    "@tesseract.js-data/kor": "1.0.0",
    "@tesseract.js-data/spa": "1.0.0",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright": "1.65.0",
    "sharp": "0.35.5"
  }
}
